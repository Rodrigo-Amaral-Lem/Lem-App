# Build helper for Android targets only; documented in docs/build-and-release.md.
# Input: selected Android ABIs plus discovered SDK paths or LEM_ANDROID_OPENSSL_ROOT.
# Effect: validate suffixed OpenSSL 3 ELF libraries and add them to Qt Android deployment metadata.

# OpenSSL 3 binaries built for Android, e.g. the repository recommended by Qt:
# https://github.com/KDAB/android_openssl
# Keep the dependency outside the source package; never use host/system OpenSSL.
include_guard(GLOBAL)

# Qt Creator downloads may be either one repository or separate ABI archives.
function(_lem_android_openssl_libdir root abi output)
    if(IS_DIRECTORY "${root}/ssl_3/${abi}")
        set(repo "${root}")
    else()
        set(repo "${root}/openssl-android-${abi}")
    endif()
    set(dir "${repo}/ssl_3/${abi}")
    if(CMAKE_BUILD_TYPE STREQUAL "Debug"
       AND EXISTS "${repo}/no-asm/ssl_3/${abi}/libcrypto_3.so"
       AND EXISTS "${repo}/no-asm/ssl_3/${abi}/libssl_3.so")
        set(dir "${repo}/no-asm/ssl_3/${abi}")
    endif()
    set(${output} "${dir}" PARENT_SCOPE)
endfunction()

function(lem_deploy_android_openssl target)
    if(NOT ANDROID)
        return()
    endif()
    set(LEM_ANDROID_OPENSSL_ROOT "" CACHE PATH "Android OpenSSL repository or Qt Creator download folder (empty = automatic)")
    set(abis ${QT_ANDROID_ABIS})
    if(NOT abis)
        set(abis ${CMAKE_ANDROID_ARCH_ABI})
    endif()
    if(NOT abis)
        set(abis ${ANDROID_ABI})
    endif()
    if(NOT abis)
        message(FATAL_ERROR "Android ABI is unknown; select an Android Qt kit before configuring OpenSSL.")
    endif()
    list(REMOVE_DUPLICATES abis)

    # Explicit CMake configuration wins. A persistent environment override works
    # across extracted project versions; invalid overrides must not silently fall back.
    set(root "${LEM_ANDROID_OPENSSL_ROOT}")
    if(NOT root AND NOT "$ENV{LEM_ANDROID_OPENSSL_ROOT}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{LEM_ANDROID_OPENSSL_ROOT}" root)
    endif()
    if(NOT root)
        set(candidates)
        foreach(sdk IN ITEMS "${ANDROID_SDK_ROOT}" "${ANDROID_SDK}" "${ANDROID_HOME}"
                "$ENV{ANDROID_SDK_ROOT}" "$ENV{ANDROID_HOME}")
            if(NOT sdk STREQUAL "")
                list(APPEND candidates "${sdk}/android_openssl")
            endif()
        endforeach()
        if(NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
            list(APPEND candidates "$ENV{LOCALAPPDATA}/Android/Sdk/android_openssl")
        endif()
        if(NOT "$ENV{HOME}" STREQUAL "")
            list(APPEND candidates "$ENV{HOME}/Android/Sdk/android_openssl"
                "$ENV{HOME}/Library/Android/sdk/android_openssl")
        endif()
        list(APPEND candidates "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../third_party/android_openssl")
        list(REMOVE_DUPLICATES candidates)
        foreach(candidate IN LISTS candidates)
            file(TO_CMAKE_PATH "${candidate}" candidate)
            set(complete TRUE)
            foreach(abi IN LISTS abis)
                _lem_android_openssl_libdir("${candidate}" "${abi}" dir)
                if(NOT EXISTS "${dir}/libcrypto_3.so" OR NOT EXISTS "${dir}/libssl_3.so")
                    set(complete FALSE)
                endif()
            endforeach()
            if(complete)
                set(root "${candidate}")
                break()
            endif()
        endforeach()
    endif()
    if(NOT root)
        message(FATAL_ERROR
            "Android HTTPS requires OpenSSL 3 libraries for ${abis}. Download Android OpenSSL in Qt Creator. "
            "Standard SDK folders and openssl-android-<ABI>/ssl_3 are detected automatically. "
            "For a custom location, set LEM_ANDROID_OPENSSL_ROOT as a CMake PATH or environment variable. "
            "Do not use /system/lib, desktop OpenSSL, or unsuffixed libcrypto.so/libssl.so. "
            "Searched: ${candidates}")
    endif()
    get_filename_component(root "${root}" ABSOLUTE)
    set(libraries)
    foreach(abi IN LISTS abis)
        _lem_android_openssl_libdir("${root}" "${abi}" libdir)
        foreach(name IN ITEMS crypto ssl)
            set(lib "${libdir}/lib${name}_3.so")
            if(NOT EXISTS "${lib}")
                message(FATAL_ERROR "Missing Android OpenSSL library: ${lib}. Download binaries for every selected ABI (${abis}).")
            endif()
            # Reject host DLLs, placeholders and wrong-ABI ELF files before deployment.
            file(READ "${lib}" header OFFSET 0 LIMIT 20 HEX)
            string(TOLOWER "${header}" header)
            if(abi STREQUAL "arm64-v8a")
                set(elf_class "02")
                set(elf_machine "b700")
            elseif(abi STREQUAL "armeabi-v7a")
                set(elf_class "01")
                set(elf_machine "2800")
            elseif(abi STREQUAL "x86_64")
                set(elf_class "02")
                set(elf_machine "3e00")
            elseif(abi STREQUAL "x86")
                set(elf_class "01")
                set(elf_machine "0300")
            else()
                message(FATAL_ERROR "Unsupported Android OpenSSL ABI: ${abi}")
            endif()
            if(NOT header MATCHES "^7f454c46${elf_class}01[0-9a-f]+${elf_machine}$")
                message(FATAL_ERROR "${lib} is not a little-endian ELF library for ${abi}. Use Android binaries, not desktop OpenSSL.")
            endif()
            list(APPEND libraries "${lib}")
        endforeach()
    endforeach()
    get_target_property(existing ${target} QT_ANDROID_EXTRA_LIBS)
    if(NOT existing)
        set(existing)
    endif()
    foreach(lib IN LISTS existing)
        get_filename_component(name "${lib}" NAME)
        if(name MATCHES "^lib(ssl|crypto)" AND NOT lib IN_LIST libraries)
            message(FATAL_ERROR "Conflicting OpenSSL library already configured: ${lib}. Remove old OpenSSL includes/Additional Libraries entries and use LEM_ANDROID_OPENSSL_ROOT.")
        endif()
    endforeach()
    list(APPEND existing ${libraries})
    list(REMOVE_DUPLICATES existing)
    set_property(TARGET ${target} PROPERTY QT_ANDROID_EXTRA_LIBS "${existing}")
    message(STATUS "Lem Android OpenSSL (_3): ${libraries}")
endfunction()
